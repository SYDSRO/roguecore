# ─────────────────────────────────────────────────────────────
#  Copy this file to ".env" for local development.
#  NEVER commit the real ".env" file — it holds secrets.
#  In production, set these in the Cloudflare dashboard instead.
# ─────────────────────────────────────────────────────────────

# Stripe — get these from https://dashboard.stripe.com/apikeys
# Use the TEST keys (they start with sk_test_) while developing.
#STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# Supabase — get these from your Supabase project:
# Project Settings → Data API (URL) and API Keys (service_role key).
# The service_role key is a SECRET. Server-only. Never expose it to the browser.
#SUPABASE_URL=https://your-project-ref.supabase.co
#SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
